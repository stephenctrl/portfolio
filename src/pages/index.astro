---
import '../global.css';
import { DotField } from '../components/DotField.jsx';
import projects from '../data/projects.json';

const SKILLS = [
  { label: "Languages", items: ["Java", "PHP", "SQL", "Python","TypeScript","Dart", "x86 Assembly"] },
  { label: "Frontend", items: ["HTML", "CSS", "JavaScript", "Astro"] },
  { label: "Databases", items: ["MySQL", "PostgreSQL", "MongoDB","SQLite"] },
  { label: "Systems", items: ["Linux", "Fedora", "EndeavourOS", "Bash"] },
  { label: "Tools", items: ["Git", "NetBeans", "GlassFish", "GitHub Actions","Docker","Flutter","Node.js","Figma"] },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Stephen Pangan | Portfolio</title>
  </head>
  <body>
    <div id="scroll-root" class="h-full overflow-y-auto bg-[#0a0a0a]">
      
      <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-8 py-4 transition-all duration-300 border-b border-transparent bg-transparent">
        <span style="font-family: 'JetBrains Mono', monospace" class="text-sm font-medium tracking-widest text-[#673ab8]">
          MSP
        </span>
        <div class="flex gap-8">
          {["Work", "About", "Contact"].map((item) => (
            <a href={`#${item.toLowerCase()}`} style="font-family: 'JetBrains Mono', monospace" class="text-xs tracking-widest text-[#888888] hover:text-[#f0f0f0] transition-colors duration-200 uppercase">
              {item}
            </a>
          ))}
        </div>
      </nav>

      <section id="hero" class="relative min-h-screen flex flex-col justify-end pb-20 px-8 md:px-16 overflow-hidden">
        <DotField client:only="react" />
        <div class="relative z-10 max-w-5xl">
          <p style="font-family: 'JetBrains Mono', monospace" class="text-xs tracking-[0.3em] text-[#673ab8] uppercase mb-6">
            Available for work — 2026
          </p>
          <h1 class="text-[clamp(3rem,10vw,8rem)] font-light leading-[0.92] tracking-tight text-[#f0f0f0] mb-8" style="font-family: 'DM Sans', sans-serif">
            Stephen
            <br />
            <span class="text-[#673ab8]">Pangan</span>
          </h1>
          <div class="flex flex-col md:flex-row md:items-end gap-8 md:gap-16">
            <p class="text-base md:text-lg text-[#888888] max-w-md leading-relaxed font-light">
              Computer Science student building systems that scale and interfaces that feel inevitable. Focused on backend engineering and DevOps.
            </p>
            <div class="flex gap-6 shrink-0">
              <a href="#work" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-medium bg-[#673ab8] text-[#0a0a0a] hover:bg-white transition-colors duration-200" style="font-family: 'JetBrains Mono', monospace">
                View work →
              </a>
            </div>
          </div>
        </div>
      </section>

      <section id="work" class="px-8 md:px-16 py-24 max-w-5xl mx-auto w-full">
        <div class="flex items-baseline justify-between mb-16">
          <h2 class="text-xs tracking-[0.3em] text-[#444] uppercase" style="font-family: 'JetBrains Mono', monospace">
            Selected Projects
          </h2>
          <span class="text-xs text-[#333]" style="font-family: 'JetBrains Mono', monospace">
            {projects.length} total
          </span>
        </div>
        <div>
          {projects.map((project, index) => (
            <a href={project.url} class="group block border-t border-[#222222] hover:border-[#673ab8] transition-all duration-300">
              <div class="py-8 grid grid-cols-[auto_1fr_auto] md:grid-cols-[60px_1fr_120px_120px] gap-4 md:gap-8 items-start">
                <span style="font-family: 'JetBrains Mono', monospace" class="text-xs text-[#333] pt-1">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="space-y-3">
                  <div class="flex flex-wrap items-baseline gap-3">
                    <h3 class="text-xl md:text-2xl font-medium text-[#f0f0f0] group-hover:text-[#673ab8] transition-colors duration-200" style="font-family: 'DM Sans', sans-serif">
                      {project.name}
                    </h3>
                    <span style="font-family: 'JetBrains Mono', monospace" class="text-[10px] tracking-widest text-[#555] uppercase">
                      {project.language || "Repository"}
                    </span>
                  </div>
                  <p class="text-sm text-[#666] leading-relaxed max-w-lg font-light">
                    {project.description || "No description provided."}
                  </p>
                  <div class="flex flex-wrap gap-2 pt-1">
                    {(project.topics || []).map((topic) => (
                      <span style="font-family: 'JetBrains Mono', monospace" class="text-[10px] px-2 py-1 border border-[#222] text-[#555] tracking-wide">
                        {topic}
                      </span>
                    ))}
                  </div>
                </div>
                <span style="font-family: 'JetBrains Mono', monospace" class="text-xs text-[#333] pt-1 text-right col-start-3 md:col-start-3">
                  {new Date(project.created_at).getFullYear()}
                </span>
                <span class="hidden md:block text-right text-[#673ab8] text-sm pt-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200" style="font-family: 'JetBrains Mono', monospace">
                  View →
                </span>
              </div>
            </a>
          ))}
          <div class="border-t border-[#222222]" />
        </div>
      </section>

      <section id="about" class="px-8 md:px-16 py-24 border-t border-[#1a1a1a]">
        <div class="max-w-5xl mx-auto grid md:grid-cols-[1fr_1fr] gap-16 md:gap-24">
          <div>
            <p class="text-xs tracking-[0.3em] text-[#444] uppercase mb-10" style="font-family: 'JetBrains Mono', monospace">About</p>
            <p class="text-[#888] text-base leading-loose font-light mb-6">
              I write systems and web applications that don't apologize for being fast. Currently studying Computer Science at the University of Santo Tomas.
            </p>
            <p class="text-[#666] text-sm leading-loose font-light">
              Before this: diving deep into software development with Java, PHP, and SQL, and pursuing a learning roadmap targeting DevOps and MLOps engineering roles. I think good taste in tooling is underrated.
            </p>
          </div>
          <div>
            <p class="text-xs tracking-[0.3em] text-[#444] uppercase mb-10" style="font-family: 'JetBrains Mono', monospace">Skills</p>
            <div class="space-y-6">
              {SKILLS.map((group) => (
                <div>
                  <p class="text-[10px] tracking-widest text-[#333] uppercase mb-3" style="font-family: 'JetBrains Mono', monospace">{group.label}</p>
                  <div class="flex flex-wrap gap-2">
                    {group.items.map((item) => (
                      <span class="text-xs px-3 py-1.5 border border-[#1f1f1f] text-[#666] hover:border-[#673ab8] hover:text-[#673ab8] transition-colors duration-200 cursor-default" style="font-family: 'JetBrains Mono', monospace">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

    </div>

    <script>
      const nav = document.getElementById('navbar');
      const root = document.getElementById('scroll-root');
      if (nav && root) {
        root.addEventListener('scroll', () => {
          if (root.scrollTop > 40) {
            nav.style.borderBottom = "1px solid #222222";
            nav.style.background = "rgba(10,10,10,0.92)";
            nav.style.backdropFilter = "blur(12px)";
          } else {
            nav.style.borderBottom = "1px solid transparent";
            nav.style.background = "transparent";
            nav.style.backdropFilter = "none";
          }
        });
      }
    </script>
  </body>
</html>