---
const { class: className = '' } = Astro.props;
---
<div class={`rounded-3xl p-6 border border-white/10 backdrop-blur-md bg-zinc-950/50 overflow-hidden hover:bg-zinc-900/50 transition-colors duration-300 flex flex-col ${className}`}>
  <!-- The <slot /> tag injects whatever content we put inside this component -->
  <slot />
</div>